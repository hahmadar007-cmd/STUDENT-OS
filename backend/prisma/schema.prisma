datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum GroupRole {
  LEADER
  MEMBER
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  DEEPSEEK
  OPENROUTER
  CUSTOM
}

model University {
  id      String   @id @default(uuid())
  name    String   @unique
  users   User[]
  courses Course[]
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  password          String?
  name              String?
  fouzarId          String?       @unique
  avatarUrl         String?
  universityId      String?
  university        University?   @relation(fields: [universityId], references: [id])
  courses           Course[]
  createdGroups     Group[]       @relation("GroupCreator")
  memberships       Membership[]
  messages          ChatMessage[]
  directMessages    DirectMessage[]
  friendships       Friendship[]  @relation("UserFriendships")
  friendOf          Friendship[]  @relation("FriendOfUser")

  // Focus Mode State
  isFocusing        Boolean       @default(false)
  focusStartedAt    DateTime?

  // AI Settings
  preferredAiModel  String?

  // LMS Integration
  lmsToken          String?
  lmsBaseUrl        String?
  lmsProvider       String?   @default("moodle")

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  passwordResetToken   String?  
  passwordResetExpiry  DateTime?

  // Personal Diary Lock
  diaryPin             String?

  // Admin flag – used for privileged endpoint access
  isAdmin              Boolean       @default(false)

  // AI Provider credentials
  aiProviders          AiProvider[]
  subjectVideos        SubjectVideo[]

  // Student Portal Integration
  portalProfile        StudentPortalProfile?

  // Cloud Migration Storage
  subjects             Subject[]
  materials            Material[]
  subjectLinks         SubjectLink[]

  // Personal Diary
  diaryEntries         DiaryEntry[]
}

model Course {
  id           String     @id @default(uuid())
  name         String
  code         String
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups       Group[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Group {
  id           String        @id @default(uuid())
  name         String
  courseId     String?
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  creatorId    String
  creator      User          @relation("GroupCreator", fields: [creatorId], references: [id])
  currentSlide String?
  sharedNotes  String?       @db.Text
  memberships  Membership[]
  messages     ChatMessage[]
  files        GroupFile[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Membership {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole @default(MEMBER)
  status    String    @default("ACCEPTED") // PENDING, ACCEPTED
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  slideId   String?
  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([senderId])
}

// DirectMessage is for private 1-on-1 chats. It uses a plain roomId string
// (e.g. "dm-userA-userB") with NO foreign key to Group, so DM rooms do not
// need a matching Group record in the database.
model DirectMessage {
  id        String   @id @default(uuid())
  roomId    String   // canonical sorted pair, e.g. "dm-<idA>-<idB>"
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([senderId])
}

model AiConfig {
  id           String   @id @default(uuid())
  provider     String
  modelName    String
  apiKey       String   // Points to the env variable name (e.g. GEMINI_API_KEY)
  isActive     Boolean  @default(true)
  universityId String?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([universityId])
  @@index([userId])
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, ACCEPTED
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model GroupFile {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    String   @default("0 KB")
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@index([groupId])
}

model SubjectVideo {
  id        String   @id @default(uuid())
  url       String
  title     String
  folderId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([folderId])
}

model AiProvider {
  id           String       @id @default(uuid())
  name         String
  providerType ProviderType @default(CUSTOM)
  apiKey       String       // AES-256-CBC encrypted before storage
  baseUrl      String?      // For local/Ollama or custom OpenAI-compatible endpoints
  isActive     Boolean      @default(false)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([userId])
}

model StudentPortalProfile {
  id            String           @id @default(uuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalUrl     String?
  portalType    String?          // moodle, canvas, blackboard, custom
  studentId     String?
  gpa           Float?
  cgpa          Float?
  semester      String?
  lastSyncedAt  DateTime?
  syncStatus    String?          @default("never")
  syncError     String?
  attendance    AttendanceStat[]
  transcript    TranscriptEntry[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model AttendanceStat {
  id           String               @id @default(uuid())
  profileId    String
  profile      StudentPortalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subjectCode  String               @default("")
  subjectName  String
  total        Int
  attended     Int
  percentage   Float
  createdAt    DateTime             @default(now())

  @@index([profileId])
}

model TranscriptEntry {
  id           String               @id @default(uuid())
  profileId    String
  profile      StudentPortalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subjectCode  String               @default("")
  subjectName  String
  creditHours  Int                  @default(3)
  grade        String?
  gradePoints  Float?
  semester     String?
  createdAt    DateTime             @default(now())

  @@index([profileId])
}

model Subject {
  id              String     @id @default(uuid())
  name            String
  code            String?
  parentSubjectId String?
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials       Material[]
  links           SubjectLink[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
}

model Material {
  id          String   @id @default(uuid())
  fileName    String
  courseCode  String?
  category    String   @default("other")
  sizeLabel   String?
  mimeType    String?
  fileUrl     String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
}

model SubjectLink {
  id        String   @id @default(uuid())
  url       String
  title     String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
}

model DiaryEntry {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
