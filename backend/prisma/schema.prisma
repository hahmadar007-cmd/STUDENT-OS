datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum GroupRole {
  LEADER
  MEMBER
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  CUSTOM
}

model University {
  id      String   @id @default(uuid())
  name    String   @unique
  users   User[]
  courses Course[]
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  password          String?
  name              String?
  fouzarId          String?       @unique
  avatarUrl         String?
  universityId      String?
  university        University?   @relation(fields: [universityId], references: [id])
  courses           Course[]
  createdGroups     Group[]       @relation("GroupCreator")
  memberships       Membership[]
  messages          ChatMessage[]
  friendships       Friendship[]  @relation("UserFriendships")
  friendOf          Friendship[]  @relation("FriendOfUser")

  // Focus Mode State
  isFocusing        Boolean       @default(false)
  focusStartedAt    DateTime?

  // AI Settings
  preferredAiModel  String?

  // LMS Integration
  lmsToken          String?
  lmsBaseUrl        String?
  lmsProvider       String?   @default("moodle")

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  passwordResetToken   String?  
  passwordResetExpiry  DateTime?

  // AI Provider credentials
  aiProviders          AiProvider[]
}

model Course {
  id           String     @id @default(uuid())
  name         String
  code         String
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups       Group[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Group {
  id           String        @id @default(uuid())
  name         String
  courseId     String?
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  creatorId    String
  creator      User          @relation("GroupCreator", fields: [creatorId], references: [id])
  currentSlide String?
  memberships  Membership[]
  messages     ChatMessage[]
  files        GroupFile[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Membership {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole @default(MEMBER)
  status    String    @default("ACCEPTED") // PENDING, ACCEPTED
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  slideId   String?
  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([senderId])
}

model AiConfig {
  id           String   @id @default(uuid())
  provider     String
  modelName    String
  apiKey       String   // Points to the env variable name (e.g. GEMINI_API_KEY)
  isActive     Boolean  @default(true)
  universityId String?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([universityId])
  @@index([userId])
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, ACCEPTED
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model GroupFile {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    String   @default("0 KB")
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@index([groupId])
}

model AiProvider {
  id           String       @id @default(uuid())
  name         String
  providerType ProviderType @default(CUSTOM)
  apiKey       String       // AES-256-CBC encrypted before storage
  baseUrl      String?      // For local/Ollama or custom OpenAI-compatible endpoints
  isActive     Boolean      @default(false)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([userId])
}